{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SW PANEL LOADER",
  "version": "0.1.5",
  "identifier": "com.seventhwell.panelloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SW PANEL LOADER",
        "width": 980,
        "height": 700,
        "minWidth": 860,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SEVENTHWELL",
    "shortDescription": "TURZX 8.8インチ画面に画像を入れるアプリ",
    "windows": {
      "nsis": { "languages": ["Japanese"], "displayLanguageSelector": false },
      "wix": { "language": "ja-JP" }
    }
  }
}
